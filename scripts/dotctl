#!/usr/bin/env python3
"""Read-only repository planner, static validator and host package probe."""
import argparse
import json
import os
import platform
from datetime import datetime, timezone
import re
import shlex
import shutil
import subprocess
import sys
from pathlib import Path

ROOT = Path(__file__).resolve().parents[1]
NAME = re.compile(r"[a-zA-Z0-9][a-zA-Z0-9@._+\-]*\Z")
DOCS = ("README.md", "AGENT.md", "AGENTS.md", "docs/REQUIREMENTS.md",
        "docs/INFRASTRUCTURES.md", "docs/IMPLEMENTATION.md", "docs/VALIDATION.md",
        "docs/DECISIONS.md", "docs/REFERENCES.md")


def settings():
    return json.loads((ROOT / "profiles/profiles.json").read_text())


def manifest(group):
    if not NAME.fullmatch(group):
        raise ValueError(f"Invalid group: {group}")
    out = []
    for line in (ROOT / "packages" / (group + ".txt")).read_text().splitlines():
        name = line.split("#", 1)[0].strip()
        if not name:
            continue
        if not NAME.fullmatch(name) or name.endswith("-git"):
            raise ValueError(f"Invalid or development package in {group}: {name}")
        if name in out:
            raise ValueError(f"Duplicate package in {group}: {name}")
        out.append(name)
    if not out:
        raise ValueError(f"Empty manifest: {group}")
    return out


def resolve(profile, extra=()):
    cfg = settings()
    if profile not in cfg["profiles"]:
        raise ValueError(f"Unknown profile: {profile}")
    if any(group not in cfg["optional_groups"] for group in extra):
        raise ValueError("Unknown or non-optional group in --with")
    groups = list(dict.fromkeys(cfg["profiles"][profile] + list(extra)))
    if "native-audit" in groups:
        raise ValueError("Native audit list cannot be installed as a group")
    return groups, list(dict.fromkeys(p for g in groups for p in manifest(g)))


def validate():
    for path in DOCS:
        if not (ROOT / path).is_file():
            raise ValueError(f"Missing document: {path}")
    cfg = settings()
    for profile in cfg["profiles"]:
        _, pkgs = resolve(profile)
        if {"yapfast", "gamemode", "xfce-polkit", "noctalia", "wl-clip-persist"} & set(pkgs):
            raise ValueError(f"Default profile contains excluded or gated component: {profile}")
    for group in cfg["optional_groups"] + ["native-audit"]:
        manifest(group)
    for base in (ROOT / "config", ROOT / "systemd", ROOT / "system"):
        for path in base.rglob("*"):
            if path.is_file() and path.name != "README.md" and not path.name.endswith(".example"):
                raise ValueError(f"Non-example config in scaffold: {path.relative_to(ROOT)}")
    colors = json.loads((ROOT / "themes/fallback.json").read_text())
    required = {"background", "surface", "surface_raised", "foreground", "muted", "accent", "on_accent", "border", "error", "warning", "success"}
    if set(colors) != required or any(not re.fullmatch(r"#[0-9a-fA-F]{6}", v) for v in colors.values()):
        raise ValueError("Fallback palette role or color format mismatch")
    def luminance(h):
        vals = [int(h[i:i+2], 16)/255 for i in (1, 3, 5)]
        return sum(w * (x/12.92 if x <= 0.04045 else ((x+0.055)/1.055)**2.4)
                   for w, x in zip((0.2126, 0.7152, 0.0722), vals))
    for a, b in (("foreground", "background"), ("foreground", "surface"),
                 ("muted", "background"), ("on_accent", "accent")):
        hi, lo = sorted((luminance(colors[a]), luminance(colors[b])), reverse=True)
        if (hi+0.05)/(lo+0.05) < 4.5:
            raise ValueError(f"Insufficient fallback contrast: {a}/{b}")
    from desktop import deploy
    mapped = {src for src, _ in deploy.files()}
    actual = {p for p in deploy.PAYLOAD.rglob("*") if p.is_file() and p != deploy.PAYLOAD / "files.json"}
    if mapped != actual:
        raise ValueError("Deployment allowlist and desktop payload differ")
    if colors != json.loads((deploy.PAYLOAD / "theme/fallback.json").read_text()):
        raise ValueError("Deployed fallback palette differs from the canonical palette")
    print("PASS: scaffold structure, manifests, profiles and fallback palette. Host checks NOT run.")
    return 0


def plan(profile, extra):
    groups, pkgs = resolve(profile, extra)
    print(f"PLAN ONLY — profile: {profile}\nGroups: {', '.join(groups)}")
    print(f"{len(pkgs)} unique candidate package names; dependencies not resolved.")
    print("Review host metadata and transaction before manually executing:")
    print(shlex.join(["sudo", "pacman", "-Syu", "--needed", *pkgs]))
    print("No packages, configurations or services were changed. External artifacts excluded.")
    return 0


def supported_host():
    os_release = Path("/etc/os-release")
    distro = os_release.read_text() if os_release.exists() else ""
    return bool(re.search(r'^ID=["\']?cachyos["\']?$', distro, re.M) and shutil.which("pacman"))


def native_audit():
    print("Native audit (installed state; absence can be legitimate):")
    for pkg in manifest("native-audit"):
        try:
            result = subprocess.run(["pacman", "-Q", "--", pkg], capture_output=True,
                                    text=True, timeout=10, check=False)
            print(result.stdout.strip() if result.returncode == 0 else f"not installed: {pkg}")
        except (OSError, subprocess.TimeoutExpired):
            print(f"unknown: {pkg}")


def probe(label, argv, pattern, empty=None, codes=(0,)):
    """Print selected fields only. Child diagnostics can contain private paths."""
    try:
        result = subprocess.run(argv, capture_output=True, text=True, errors="replace",
                                timeout=10, env={**os.environ, "LC_ALL": "C"})
    except FileNotFoundError:
        print(f"{label}: BLOCKED (missing {argv[0]})")
        return
    except (OSError, subprocess.TimeoutExpired):
        print(f"{label}: BLOCKED (could not complete {argv[0]})")
        return
    if result.returncode not in codes:
        print(f"{label}: BLOCKED ({argv[0]} exited {result.returncode})")
        return
    fields = list(dict.fromkeys(re.findall(pattern, result.stdout, re.M)))
    print(f"{label}: " + (", ".join(fields) or empty or "BLOCKED (no matching observation)"))


def drm_inventory(root):
    drivers = set()
    modes = set()
    try:
        for card in root.glob("card[0-9]*"):
            driver = card / "device/driver"
            if driver.is_symlink():
                drivers.add(driver.resolve().name)
            status = card / "status"
            if status.is_file() and status.read_text().strip() == "connected":
                modes.update(re.findall(r"^\d+x\d+$", (card / "modes").read_text(), re.M))
    except OSError:
        print("DRM inventory: BLOCKED (incomplete sysfs access)")
    print("GPU kernel drivers: " + (", ".join(sorted(drivers)) or "unavailable"))
    print("Advertised resolutions: " + (", ".join(sorted(modes)) or "unavailable"))


def baseline():
    print("M1 host observations (UTC)", datetime.now(timezone.utc).isoformat(timespec="seconds"))
    if not supported_host():
        print("BLOCKED: requires CachyOS and pacman")
        return 2
    print("Running kernel:", platform.release())
    probe("Repository priority", ["pacman-conf", "--repo-list"], r"^([\w.+-]+)$")
    native_audit()
    drm_inventory(Path("/sys/class/drm"))
    probe("Vulkan devices", ["vulkaninfo", "--summary"], r"^\s*deviceName\s*= *([^\r\n]+)")
    probe("VA-API decode profiles", ["vainfo"], r"^\s*(VAProfile\w+)\s*:\s*VAEntrypointVLD\b")
    probe("ZRAM devices and sizes", ["zramctl", "--noheadings", "--output", "NAME,DISKSIZE"],
          r"^\s*(/dev/zram\d+[ \t]+\S+)", empty="none reported")
    probe("ananicy-cpp service", ["systemctl", "is-active", "ananicy-cpp.service"],
          r"^(active|inactive|failed|activating|deactivating|reloading|unknown)$", codes=(0, 3, 4))
    print("Display target: 1920x1080 at 300 Hz")
    if os.environ.get("NIRI_SOCKET"):
        probe("Current Niri mode", ["niri", "msg", "outputs"],
              r"^\s*Current mode:\s*(\d+x\d+\s*@\s*[\d.]+(?:\s*Hz)?)")
    elif os.environ.get("WAYLAND_DISPLAY") or os.environ.get("XDG_SESSION_TYPE") == "wayland":
        probe("Current Wayland mode", ["wlr-randr"], r"^\s*(\d+x\d+ px, [\d.]+ Hz).*\bcurrent\b")
    elif os.environ.get("DISPLAY"):
        probe("Current X11 mode (star marks active refresh)", ["xrandr", "--current"],
              r"^\s*(\d+x\d+[ \t]+[\d. +*\t]*?\*)")
    else:
        print("Current display mode: BLOCKED (no graphical session)")
    print("PENDING: MangoWM mode and VRR, video playback, 32-bit game smoke test")
    print("V-30 M1 manual checks: authenticated recovery TTY, bootable recovery media, "
          "external backup restore (all pending)")
    return 0


def doctor(profile, extra):
    groups, pkgs = resolve(profile, extra)
    print(f"Read-only host probe: {profile} ({', '.join(groups)})")
    if not supported_host():
        print("BLOCKED: not a confirmed CachyOS host with pacman. No package query performed.")
        return 2
    missing = []
    for pkg in pkgs:
        try:
            result = subprocess.run(["pacman", "-Si", "--", pkg], capture_output=True,
                                    text=True, timeout=10, check=False)
        except (OSError, subprocess.TimeoutExpired):
            print(f"BLOCKED: query failed for {pkg}")
            missing.append(pkg)
            continue
        if result.returncode:
            missing.append(pkg)
            print(f"UNRESOLVED: {pkg}")
        else:
            print(f"AVAILABLE: {pkg}")
    native_audit()
    print("Diagnostic executables (missing may mean not installed yet):")
    for name in ("mango", "waybar", "rofi", "wpctl", "vulkaninfo", "vainfo", "chwd", "uwsm"):
        print(f"{name}: {'present' if shutil.which(name) else 'not found'}")
    print(f"{len(missing)} unresolved candidates. Local metadata can be stale; no databases refreshed.")
    print("No runtime compatibility tests performed.")
    return 1 if missing else 0


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    subs = parser.add_subparsers(dest="command", required=True)
    for action in ("plan", "doctor"):
        sub = subs.add_parser(action)
        sub.add_argument("--profile", default="daily", choices=list(settings()["profiles"]))
        sub.add_argument("--with", dest="extra", action="append", default=[], choices=settings()["optional_groups"])
    subs.add_parser("baseline", help="collect read-only M1 host observations")
    subs.add_parser("validate")
    theme = subs.add_parser("theme", help="manage the desktop palette")
    theme.add_argument("arguments", nargs=argparse.REMAINDER)
    deployment = subs.add_parser("deploy", help="plan, apply or roll back user file mappings")
    deployment.add_argument("action", choices=("install", "rollback"))
    deployment.add_argument("--apply", action="store_true")
    deployment.add_argument("--replace", action="store_true", help="back up and replace conflicting regular files")
    args = parser.parse_args()
    try:
        if args.command == "theme":
            return subprocess.call([ROOT / "desktop/theme/tool", *args.arguments])
        if args.command == "deploy":
            if args.action == "rollback" and args.replace:
                deployment.error("--replace only applies to installation")
            from desktop import deploy
            return deploy.run(args)
        if args.command == "baseline":
            return baseline()
        if args.command == "validate":
            return validate()
        return (plan if args.command == "plan" else doctor)(args.profile, args.extra)
    except (ValueError, OSError, KeyError) as exc:
        print(f"ERROR: {exc}", file=sys.stderr)
        return 1


if __name__ == "__main__":
    sys.exit(main())
