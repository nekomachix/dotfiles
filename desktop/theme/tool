#!/usr/bin/env python3
"""Generate and switch private, immutable theme revisions."""
import argparse
import fcntl
import json
import os
import re
import subprocess
import sys
import tempfile
import time
from pathlib import Path

ASSETS = Path(__file__).resolve().parent


def command(*args):
    return subprocess.run(args, check=True, capture_output=True, text=True, timeout=15).stdout


def contrast(a, b):
    def luminance(color):
        values = [int(color[i:i+2], 16) / 255 for i in (1, 3, 5)]
        return sum(weight * (x / 12.92 if x <= 0.04045 else ((x + .055) / 1.055)**2.4)
                   for weight, x in zip((.2126, .7152, .0722), values))
    lo, hi = sorted(map(luminance, (a, b)))
    return (hi + .05) / (lo + .05)


def render(directory, image):
    palette = json.loads((ASSETS / "fallback.json").read_text())
    if image:
        result = command("matugen", "-c", ASSETS / "matugen.toml", "image", image,
                         "--dry-run", "--prefer", "saturation", "--mode", "dark", "--json", "hex")
        colors = json.loads(result)["colors"]
        for role, material in {"background": "background", "foreground": "on_surface",
                               "surface": "surface_container", "accent": "primary",
                               "on_accent": "on_primary"}.items():
            palette[role] = colors[material]["dark"]["color"]
    if any(not re.fullmatch(r"#[a-fA-F0-9]{6}", color) for color in palette.values()):
        raise ValueError("Invalid palette")
    for a, b in (("foreground", "background"), ("foreground", "surface"),
                 ("muted", "background"), ("on_accent", "accent")):
        if contrast(palette[a], palette[b]) < 4.5:
            raise ValueError(f"Unreadable palette: {a}/{b}")
    bg, fg, accent, on = (palette[k] for k in ("background", "foreground", "accent", "on_accent"))
    (directory / "palette.css").write_text(
        f"@define-color desktop_bg {bg};\n@define-color desktop_fg {fg};\n"
        f"@define-color desktop_accent {accent};\n@define-color desktop_on_accent {on};\n")
    (directory / "kitty.conf").write_text(f"background {bg}\nforeground {fg}\nselection_background {accent}\nselection_foreground {on}\n")
    (directory / "colors.rasi").write_text(f"* {{ background-color: {bg}; text-color: {fg}; }}\nelement selected {{ background-color: {accent}; text-color: {on}; }}\n")
    (directory / "revision.json").write_text(json.dumps({"palette": palette, "wallpaper": str(image) if image else None}))


def point(root, name, revision):
    with tempfile.TemporaryDirectory(dir=root) as tmp:
        link = Path(tmp) / "pointer"
        link.symlink_to(revision.name)
        os.replace(link, root / name)


def wallpaper(revision):
    info = json.loads((revision / "revision.json").read_text())
    for attempt in range(5):
        try:
            command("awww", "query")
            break
        except subprocess.CalledProcessError:
            if attempt == 4:
                raise
            time.sleep(0.2)
    if info["wallpaper"]:
        command("awww", "img", "--transition-type", "none", info["wallpaper"])
    else:
        command("awww", "clear", info["palette"]["background"].lstrip("#"))


def reload_clients():
    for unit in ("waybar.service", "swaync.service"):
        status = subprocess.run(["systemctl", "--user", "is-active", "--quiet", unit], timeout=5)
        if status.returncode == 0:
            command("systemctl", "--user", "reload", unit)
        elif status.returncode not in (3, 4):
            raise ValueError(f"Could not inspect {unit}")


def main():
    parser = argparse.ArgumentParser()
    parser.add_argument("action", choices=("init", "apply", "rollback", "restore"))
    parser.add_argument("image", nargs="?", type=Path)
    parser.add_argument("--dry-run", action="store_true")
    args = parser.parse_args()
    if (args.action == "apply") != bool(args.image):
        parser.error("apply requires one wallpaper path")
    image = args.image.resolve(strict=True) if args.image else None
    if image and not image.is_file():
        raise ValueError("Expected a regular image file")
    root = Path(os.environ.get("XDG_CONFIG_HOME") or Path.home() / ".config") / "dotfiles/theme"
    if not root.is_absolute():
        raise ValueError("XDG_CONFIG_HOME must be absolute")
    if args.dry_run:
        if args.action in ("apply", "init"):
            with tempfile.TemporaryDirectory() as temp:
                render(Path(temp), image)
        print("Prepared", args.action)
        return
    if args.action != "init" and (not os.environ.get("WAYLAND_DISPLAY") or "mango" not in os.environ.get("XDG_CURRENT_DESKTOP", "").lower().split(":")):
        raise ValueError("Run this action from the Mango Wayland session")
    root.mkdir(parents=True, exist_ok=True, mode=0o700)
    with (root / ".lock").open("a") as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        current = root / "current"
        prior = root / "previous"
        if args.action == "restore":
            try:
                wallpaper(current)
            except subprocess.CalledProcessError:
                command("awww", "clear", json.loads((ASSETS / "fallback.json").read_text())["background"][1:])
            return
        if args.action == "init" and current.exists():
            return
        old = current.resolve(strict=True) if current.exists() else None
        if args.action == "rollback":
            revision = prior.resolve(strict=True)
        else:
            with tempfile.TemporaryDirectory(dir=root, prefix="prepare-") as stage:
                revision = Path(stage) / "rendered"
                revision.mkdir(mode=0o700)
                render(revision, image)
                destination = root / f"revision-{Path(stage).name.removeprefix('prepare-')}"
                revision.rename(destination)
                revision = destination
        if args.action == "init":
            point(root, "current", revision)
            return
        if not old:
            raise ValueError("Initialize the fallback with dotctl theme init first")
        point(root, "current", revision)
        try:
            wallpaper(revision)
            reload_clients()
        except (OSError, ValueError, subprocess.SubprocessError):
            point(root, "current", old)
            wallpaper(old)
            reload_clients()
            raise
        point(root, "previous", old)


if __name__ == "__main__":
    try:
        main()
    except (OSError, KeyError, ValueError, subprocess.SubprocessError) as error:
        sys.exit(f"Theme action failed: {error}")
