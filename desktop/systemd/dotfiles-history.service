[Unit]
Description=Mango desktop history
PartOf=wayland-session@mango.desktop.target
After=graphical-session.target
ConditionEnvironment=XDG_CURRENT_DESKTOP

[Service]
Type=exec
UMask=0077
ExecCondition=/lib/systemd/systemd-xdg-autostart-condition mango ""
ExecStart=/usr/bin/wl-paste --type text --watch /usr/bin/cliphist store
