[Unit]
Description=Mango desktop polkit
PartOf=wayland-session@mango.desktop.target
After=graphical-session.target
ConditionEnvironment=XDG_CURRENT_DESKTOP

[Service]
Type=exec
ExecCondition=/lib/systemd/systemd-xdg-autostart-condition mango ""
ExecStart=/usr/lib/mate-polkit/polkit-mate-authentication-agent-1
