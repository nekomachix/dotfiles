[Unit]
Description=Mango desktop wallpaper
PartOf=wayland-session@mango.desktop.target
After=graphical-session.target
ConditionEnvironment=XDG_CURRENT_DESKTOP

[Service]
Type=exec
ExecCondition=/lib/systemd/systemd-xdg-autostart-condition mango ""
ExecStart=/usr/bin/awww-daemon --no-cache
ExecStartPost="%E/dotfiles/theme/tool" restore
